NODE_ENV=development

# Public address of the deployment, used in the page metadata
BASE_URL=http://localhost:1234/

# WebSocket-to-TCP tunnel (`npm run signal:proxy`); defaults to `/tunnel` on the app origin
SIGNAL_TUNNEL_URL=ws://localhost:8787/tunnel

# Signal Secure Backups: the settings screen, the restore step of a registration and the backup schedule. Off until
# the service and the SVR-B format are checked against the live servers; set to 1 to try them.
SIGNAL_BACKUPS=
