{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TeleSignal",
  "version": "../package.json",
  "identifier": "org.telesignal.desktop",
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' wss: ws://localhost:* ws://127.0.0.1:* blob: data: ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob: data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none';",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1234",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "dist",
    "removeUnusedCommands": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["sgnl"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "category": "SocialNetworking",
    "copyright": "TeleSignal contributors",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Signal client",
    "longDescription": "TeleSignal is a Signal client that runs as a linked device. Encryption and the Signal protocol run on your computer.",
    "linux": {
      "deb": {
        "section": "net",
        "desktopTemplate": "linux/telesignal.desktop"
      }
    },
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "dmg": {
        "background": "images/background-dmg.png",
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 138,
          "y": 225
        },
        "applicationFolderPosition": {
          "x": 402,
          "y": 225
        }
      }
    },
    "resources": [],
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
