{
  "identifier": "default",
  "description": "Permissions available to the bundled TeleSignal app",
  "local": true,
  "webviews": ["*"],
  "permissions": [
    "allow-mark-title-bar-overlay",
    "allow-set-notifications-count",
    "allow-set-window-title",
    "allow-open-new-window-cmd",
    "allow-save-current-url",
    "allow-set-menu-translations",
    "allow-quit-app",
    "allow-get-desktop-settings",
    "allow-set-desktop-settings",
    "allow-show-notification",
    "allow-take-deep-links",
    "allow-signal-connect",
    "allow-signal-send",
    "allow-signal-ack",
    "allow-signal-close",
    "allow-begin-file-save",
    "allow-write-file-chunk",
    "allow-finish-file-save",
    "allow-abort-file-save",
    "allow-list-saved-files",
    "allow-open-saved-file",
    "allow-reveal-saved-file",
    "core:event:default",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-dragging",
    "process:default",
    "updater:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "shell:default"
  ]
}
